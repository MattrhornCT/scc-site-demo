{
  "name": "scc-site-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "fetch-airtable": "node --env-file-if-exists=.env scripts/fetch-airtable.mjs",
    "predev": "npm run fetch-airtable",
    "dev": "vite",
    "dev:cf": "npm run build && wrangler pages dev dist --kv RATE_LIMIT_KV",
    "prebuild": "npm run fetch-airtable",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.3",
    "vite": "^6.0.7",
    "wrangler": "^4.114.0"
  }
}
